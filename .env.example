# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Asia/Kolkata
# Local demo account only; create it with `python manage.py seed_demo --interns 1`.
DEMO_LOGIN_EMAIL=internflow.demo@example.com
DEMO_LOGIN_PASSWORD=DemoPass!12345
# Optional PostgreSQL. Leave blank to use SQLite locally.
DATABASE_URL=
# Email: console is development-only; smtp requires real credentials.
EMAIL_MODE=console
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@example.com
# Integrations remain disabled until credentials are configured.
AI_MODE=mock
AI_API_KEY=
AI_MODEL=
GOOGLE_INTEGRATION_MODE=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/integrations/google/callback/
# Upload guard
MAX_UPLOAD_MB=10
